#!/bin/bash

# KUBEFRED - Kubernetes Context and Namespace Switcher
# Usage: 
#   KUBEFRED C cluster-name    # Switch to cluster
#   KUBEFRED N namespace-name  # Switch default namespace

SCRIPT_NAME=$(basename "$0")

# Function to display usage
show_usage() {
    echo ""
    echo "██╗  ██╗██╗   ██╗██████╗ ███████╗███████╗██████╗ ███████╗██████╗ "
    echo "██║ ██╔╝██║   ██║██╔══██╗██╔════╝██╔════╝██╔══██╗██╔════╝██╔══██╗"
    echo "█████╔╝ ██║   ██║██████╔╝█████╗  █████╗  ██████╔╝█████╗  ██║  ██║"
    echo "██╔═██╗ ██║   ██║██╔══██╗██╔══╝  ██╔══╝  ██╔══██╗██╔══╝  ██║  ██║"
    echo "██║  ██╗╚██████╔╝██████╔╝███████╗██║     ██║  ██║███████╗██████╔╝"
    echo "╚═╝  ╚═╝ ╚═════╝ ╚═════╝ ╚══════╝╚═╝     ╚═╝  ╚═╝╚══════╝╚═════╝ "
    echo ""
    echo "🤖 Your Kubernetes Context and Namespace Butler 🤖"
    echo ""
    echo "Usage:"
    echo "  KUBEFRED C <cluster-name>     # Switch to specified cluster context"
    echo "  KUBEFRED N <namespace-name>   # Switch default namespace for kubectl"
    echo "  KUBEFRED L                    # List all available contexts"
    echo "  KUBEFRED S                    # Show current context and namespace status"
    echo ""
    echo "Examples:"
    echo "  KUBEFRED C production         # Switch to production cluster"
    echo "  KUBEFRED C eks-prod1          # Switch to EKS cluster"
