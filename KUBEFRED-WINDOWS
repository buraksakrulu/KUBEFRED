#!/usr/bin/env pwsh

# KUBEFRED - Kubernetes Context and Namespace Switcher for Windows
# Usage: 
#   KUBEFRED C cluster-name    # Switch to cluster
#   KUBEFRED N namespace-name  # Switch default namespace

param(
    [Parameter(Position=0)]
    [string]$Command,
    
    [Parameter(Position=1)]
    [string]$Target
)

# Function to display usage
