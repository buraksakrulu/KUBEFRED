    Write-Host "  KUBEFRED N <namespace-name>   # Switch default namespace for kubectl" -ForegroundColor Green
    Write-Host ""
    Write-Host "Examples:"
    Write-Host "  KUBEFRED C production         # Switch to production cluster"
    Write-Host "  KUBEFRED C eks-prod1          # Switch to EKS cluster"
